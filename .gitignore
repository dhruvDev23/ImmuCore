# ──────────────────────────────────────────────────────────
# .gitignore for ImmuCore
# Covers: Python, macOS, IDEs, virtual environments,
#         and project-specific ignores
# ──────────────────────────────────────────────────────────

# ── Python ────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/
*.egg

# ── Virtual environments ─────────────────────────────────
venv/
env/
.venv/
.env

# ── Jupyter Notebooks ────────────────────────────────────
.ipynb_checkpoints/

# ── macOS ────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride

# ── IDEs ─────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── Project-specific ─────────────────────────────────────
# Trained model artifacts can be large — keep them local
# but don't accidentally push multi-MB files to GitHub.
# (We'll track the final exported model deliberately.)
model/exports/*.pkl
model/exports/*.joblib

# EDA chart images — regenerated by running eda.py,
# so no need to version-control them.
model/notebooks/charts/

# Environment variable files (API keys, etc.)
.env
.env.local
